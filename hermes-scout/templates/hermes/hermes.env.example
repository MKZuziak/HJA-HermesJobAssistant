# Keys that go into Hermes' own secrets file: ~/.hermes/.env  (inside the container: /opt/data/.env)
# Append them from INSIDE the container, e.g.:  echo 'KEY=value' >> /opt/data/.env
# Never commit the real file.

# Page reading (web_extract) - https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Web search - https://api-dashboard.search.brave.com (free plan)
BRAVE_SEARCH_API_KEY=...

# Telegram - token from @BotFather, numeric user ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABC...
TELEGRAM_ALLOWED_USERS=123456789

# Optional alert mailbox read by scripts/fetch_alerts.py (IMAP, read-only use)
# Deliberately NOT named EMAIL_*: those would enable Hermes' email chat gateway.
SCOUT_IMAP_HOST=posteo.de
SCOUT_IMAP_USER=yourscout@posteo.net
SCOUT_IMAP_PASSWORD=...
