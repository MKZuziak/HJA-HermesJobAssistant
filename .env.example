# Compose settings. `make init` creates .env from this file. Never commit .env.

# Dashboard password (login: admin). `make init` generates a random one.
DASH_PASS=change-me

# Run Hermes as your host user (`id -u` / `id -g`). `make init` fills these in.
HERMES_UID=1000
HERMES_GID=1000

# Timezone for wall-clock schedules (the weekly brief runs Mondays 08:00 here).
HJA_TIMEZONE=UTC

# Upstream Hermes image tag. Pin a tested version (X.Y.Z) for reproducible builds.
HERMES_TAG=stable

# Optional: where data lives (defaults shown)
# HERMES_DATA=/home/you/.hermes
# SCOUT_MATERIALS=/home/you/scout/materials
# SCOUT_OUT=/home/you/scout/out
