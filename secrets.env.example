# Secrets and IDs for the agent. `make init` copies this to secrets.env (gitignored);
# fill it in, then run `make configure`. Re-running is safe: values are updated, not duplicated.
# Empty values are skipped.

# Web search: https://api-dashboard.search.brave.com (free plan)
BRAVE_SEARCH_API_KEY=

# Page reading: https://app.tavily.com
TAVILY_API_KEY=

# Research radar citations: free key from https://openalex.org/settings/api
OPENALEX_API_KEY=

# Telegram: bot token from @BotFather; your numeric user ID from @userinfobot.
# For a private chat with the bot, the home channel ID is your user ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# Optional alert mailbox (IMAP, read-only use by fetch_alerts.py).
# Deliberately not EMAIL_*: those names enable Hermes' email chat gateway.
SCOUT_IMAP_HOST=
SCOUT_IMAP_USER=
SCOUT_IMAP_PASSWORD=
